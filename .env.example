# Supabase (auth + Postgres)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Backboard (primary LLM for the strategic translator agent)
BACKBOARD_API_KEY=your_backboard_api_key

# Gemini (translator fallback when Backboard fails; also used for ESG PDF export narrative)
GEMINI_API_KEY=your_gemini_api_key

# Microsoft Graph (Microsoft 365 / Copilot integration)
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_TENANT_ID=your_microsoft_tenant_id

# Google (Google Workspace / Gemini integration)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Opt-in flags. Their debug routes are always enabled when NODE_ENV=development;
# Google usage collection during analysis still requires ENABLE_GOOGLE_USAGE_SPIKE=true.
ENABLE_GOOGLE_USAGE_SPIKE=false
ENABLE_BACKBOARD_TEST_ROUTE=false

# Login with GitHub / Google / Microsoft is handled by Supabase Auth providers.
# Configure those OAuth client IDs/secrets in the Supabase dashboard; the app does not read them.
